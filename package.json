{
  "name": "hr-management-backend",
  "version": "1.0.0",
  "description": "Production-ready HR Management System backend with Node.js, Express, MongoDB, and JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedAdmin.js",
    "seed:superadmin": "node scripts/seedSuperAdmin.js",
    "restore:superadmin": "node scripts/seedSuperAdmin.js --restore-super-admin",
    "test": "npm run test:attendance && node scripts/verifySystem.js && node scripts/verifyStaffLoginTracking.js && node scripts/verifyStaffLoginLocationPolicy.js && node scripts/verifyDepartmentCountsAndLeadership.js && node scripts/verifyHrDashboardWfhMetric.js && node scripts/verifyStaffAttendanceHistory.js && node scripts/verifySickMedicalLeave.js && node scripts/verifyStaffLeaveStatusAndHistory.js && node scripts/verifyAccountDeactivatedLoginIssue.js && node scripts/verifySuperAdminRestoration.js && node scripts/verifyHrDashboardConnection.js && node scripts/verifyAttendanceBasedPayroll.js && node scripts/verifyPayrollBatchPersistence.js",
    "test:payroll": "node scripts/verifyAttendanceBasedPayroll.js",
    "test:payroll-batches": "node scripts/verifyPayrollBatchPersistence.js",
    "test:salary-payments": "node scripts/verifySalaryPayments.js",
    "test:hr-dashboard-conn": "node scripts/verifyHrDashboardConnection.js",
    "test:restore-superadmin": "node scripts/verifySuperAdminRestoration.js",
    "test:account-status": "node scripts/verifyAccountDeactivatedLoginIssue.js",
    "test:leave-status": "node scripts/verifyStaffLeaveStatusAndHistory.js",
    "test:sick-medical": "node scripts/verifySickMedicalLeave.js",
    "test:staff-login": "node scripts/verifyStaffLoginTracking.js",
    "test:attendance": "node scripts/verifyAttendanceSchedule.js && node scripts/verifyAttendanceIntegration.js && node scripts/verifyDepartmentSchedulesAndLateness.js",
    "test:department-schedules": "node scripts/verifyDepartmentSchedulesAndLateness.js",
    "test:live-endpoints": "node scripts/verifyLiveEndpoints.js",
    "test:birthdays": "node scripts/verifyBirthdays.js",
    "test:birthdays:today": "node scripts/verifyBirthdayToday.js",
    "test:staff-update": "node scripts/verifyStaffUpdateLive.js",
    "test:daily-updates": "node scripts/verifyDailyUpdatesLive.js",
    "test:lifecycle": "node scripts/verifyEmployeeLifecycle.js",
    "test:chat": "node scripts/verifySharedDepartmentChat.js",
    "test:company-chat": "node scripts/verifyCompanyChat.js",
    "test:dashboard-attendance": "node scripts/verifyDashboardAttendanceMetrics.js",
    "test:wfh-metrics": "node scripts/verifyHrDashboardWfhMetric.js",
    "test:staff-attendance": "node scripts/verifyStaffAttendanceHistory.js",
    "test:leave-bulk-delete": "node scripts/verifyLeaveBulkDelete.js",
    "test:login-location-policy": "node scripts/verifyStaffLoginLocationPolicy.js",
    "test:departments": "node scripts/verifyDepartmentCountsAndLeadership.js"
  },
  "keywords": [
    "hr",
    "management",
    "express",
    "nodejs",
    "mongodb",
    "mongoose",
    "jwt",
    "rbac"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4"
  }
}
